# Copier ce fichier en .env.local pour le developpement local (non commite).
# Meme variable a creer dans Vercel > Project Settings > Environment Variables.

# Cle API Resend (dashboard Resend > API Keys). Ne jamais commiter la vraie valeur.
RESEND_API_KEY=

# Meta Pixel - laisser vide tant qu'aucun Pixel n'est configure.
# Vide  -> le composant MetaPixel est totalement inactif (aucun script, aucune requete Meta).
# Renseigne -> le pixel se charge UNIQUEMENT apres consentement "accepted".
NEXT_PUBLIC_META_PIXEL_ID=

# Supabase (projet EU/Paris) - lecture publique des annonces publiees (table listings).
# Cle anon uniquement cote site : la RLS limite l'acces aux lignes status='published'.
# Vides -> le site retombe sur la liste statique data/properties.js.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
